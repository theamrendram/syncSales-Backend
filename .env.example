# ---------------------------------------------------------------------------
# SyncSales API — environment
# Copy to .env and fill in. Values marked (required) are checked at boot by
# validateEnv() in src/config/env.js; the process refuses to start without them.
# ---------------------------------------------------------------------------

PORT=8000
NODE_ENV=development

# (required) Postgres. Local dev database is defined in ../docker-compose.yml:
#   docker compose up -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/syncsales_dev"

# --- Better Auth -----------------------------------------------------------
# (required) Signs session cookies. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of THIS api, used to build callback URLs.
BETTER_AUTH_URL=http://localhost:8000

# Origins allowed to send credentialed requests. These are also the CORS
# allowlist; anything not listed is rejected (public lead-ingestion routes are
# exempt and keep a wildcard origin).
APP_URL=http://localhost:3000
CRM_URL=http://localhost:3001
# Optional extra origins, comma separated.
EXTRA_CORS_ORIGINS=

# Share the session cookie across subdomains so one sign-in covers the
# marketing site and the CRM. Leave EMPTY in development: localhost ports are
# already same-site and a domain attribute would break the cookie.
# Production: .syncsales.in
AUTH_COOKIE_DOMAIN=

# --- Google OAuth ----------------------------------------------------------
# Authorised redirect URI to register:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (verification, password reset, org invitations) ------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when unset.
SMTP_FROM=

# --- Payments --------------------------------------------------------------
# (required)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_BASIC=
RAZORPAY_PLAN_ID_PRO=

# --- Clerk (being removed — kept until Phase 6 so a revert stays trivial) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
