generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String               @id @default(uuid())
  // Better Auth writes `name`, not these two. The defaults keep its inserts
  // legal; databaseHooks.user.create.before in src/lib/auth.js splits `name`
  // and fills them, so every row still carries real values.
  firstName               String               @default("")
  lastName                String               @default("")
  email                   String               @unique
  companyName             String?

  // Better Auth identity fields. `name` is nullable because existing rows
  // predate it and are backfilled from firstName + lastName; Better Auth
  // always supplies it for new signups. The old plaintext `password` column
  // is gone — credentials now live hashed in Account.password.
  name                    String?
  emailVerified           Boolean              @default(false)
  image                   String?
  apiKey                  String               @unique @default("0")
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  address                 String?
  phone                   String?
  organizationId          String?
  ownedCampaigns          Campaign[]           @relation("CampaignOwner")
  leads                   Lead[]
  ownedOrganization       Organization?        @relation("Owner")
  organizationMemberships OrganizationMember[]
  payments                Payment[]
  routes                  Route[]
  subscription            Subscription[]
  userPlan                UserPlan?            @relation("UserToUserPlan")
  webmasterProfile             WebmasterProfile?
  webmasterCampaignMemberships CampaignWebmaster[] @relation("CampaignWebmasterMembership")
  resourceAccess               AccessControl[]

  sessions                Session[]
  accounts                Account[]
  memberships             Member[]
  sentInvitations         Invitation[]         @relation("InvitationInviter")
}

model WebmasterProfile {
  userId    String   @id
  isActive  Boolean  @default(true)
  leadLimit Int?
  payout    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model Organization {
  id             String               @id @default(uuid())
  name           String
  // Nullable only so the organization plugin's INSERT is valid: it does not
  // know about ownerId. beforeCreateOrganization sets it in the same call, and
  // @unique still enforces one organization per owner.
  ownerId        String?              @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  description    String?
  domain         String?
  logo           String?

  // Required by the Better Auth organization plugin. Nullable so the migration
  // applies to existing rows; Postgres permits many NULLs under a unique index,
  // and the backfill assigns real slugs.
  slug           String?              @unique
  metadata       String?
  campaigns      Campaign[]
  leads          Lead[]
  owner          User?                @relation("Owner", fields: [ownerId], references: [id])
  members        OrganizationMember[]
  payments       Payment[]
  Role           Role[]
  routes         Route[]
  subscriptions  Subscription[]
  userPlans      UserPlan[]
  orgLeadCounter OrgLeadCounter?
  resourceAccess AccessControl[]

  authMembers    Member[]
  invitations    Invitation[]

  @@index([ownerId])
}

model OrgLeadCounter {
  organizationId String       @id
  nextValue      Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Role {
  id             String               @id @default(uuid())
  name           String
  description    String?
  permissions    Json
  organizationId String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        OrganizationMember[]
  organization   Organization         @relation(fields: [organizationId], references: [id])

  @@unique([name, organizationId])
  @@index([organizationId])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  status         MemberStatus @default(active)
  joinedAt       DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
}

model UserPlan {
  id              String        @id @default(uuid())
  userId          String        @unique
  name            String
  price           Float
  currency        String
  billingCycle    String
  maxWebmasters   Int
  dailyLeadsLimit Int
  features        Json?
  isTrial         Boolean       @default(false)
  startDate       DateTime      @default(now())
  endDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  user            User          @relation("UserToUserPlan", fields: [userId], references: [id])

  @@index([organizationId])
}

model Route {
  id             String        @id @default(uuid())
  userId         String
  product        String
  payout         Float
  name           String
  attributes     Json?
  method         String?
  url            String?
  routeId        Int           @default(autoincrement())
  description    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  hasWebhook     Boolean       @default(true)
  deletedAt      DateTime?
  organizationId String?
  campaigns      Campaign[]
  Lead           Lead[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  resourceAccess AccessControl[]

  @@index([organizationId])
  @@index([userId])
}

model Campaign {
  id               String        @id @default(uuid())
  name             String
  userId           String
  routeId          String
  campId           String
  status           Status        @default(active)
  manager          String
  isArchived       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  lead_period      Int           @default(90)
  updatedAt        DateTime      @updatedAt
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  route            Route         @relation(fields: [routeId], references: [id])
  owner            User          @relation("CampaignOwner", fields: [userId], references: [id])
  webmasterMemberships CampaignWebmaster[]
  Lead             Lead[]
  resourceAccess   AccessControl[]

  @@index([campId])
  @@index([status])
  @@index([userId])
  @@index([routeId])
  @@index([organizationId])
}

model CampaignWebmaster {
  id         String   @id @default(uuid())
  campaignId String
  userId     String
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation("CampaignWebmasterMembership", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId])
}

model AccessControl {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  routeId        String?
  campaignId     String?
  accessType     AccessType   @default(view)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  route          Route?       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId])
  @@index([organizationId])
  @@index([routeId])
  @@index([campaignId])
  @@index([userId, routeId])
  @@index([userId, campaignId])
}

model Lead {
  id              String        @id @default(uuid())
  firstName       String
  lastName        String?
  phone           String
  email           String?
  address         String?
  status          String
  sub1            String?
  sub2            String?
  sub3            String?
  sub4            String?
  campaignId      String?
  routeId         String
  userId          String
  orgLeadId       Int?
  date            DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ip              String?
  country         String?
  webhookResponse Json?
  companyId       String?
  organizationId  String?
  campaign        Campaign?     @relation(fields: [campaignId], references: [id])
  organization    Organization? @relation(fields: [organizationId], references: [id])
  route           Route         @relation(fields: [routeId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([organizationId, orgLeadId])
  @@index([status])
  @@index([date])
  @@index([userId])
  @@index([routeId])
  @@index([campaignId])
  @@index([phone])
  @@index([companyId])
  @@index([organizationId])
}

model LeadUsage {
  id             String   @default(uuid())
  userId         String
  date           DateTime
  count          Int      @default(1)
  organizationId String?

  @@unique([userId, date])
  @@index([organizationId])
}

model Payment {
  id             String        @id @default(uuid())
  amount         Float
  currency       String
  status         String
  paymentMethod  String
  transactionId  String?
  userId         String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  description    String?
  receiptUrl     String?
  metadata       Json?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Subscription {
  id                     String             @id @default(uuid())
  razorpayPaymentId      String
  billingCycle           String
  plan                   String
  userId                 String?
  createdAt              DateTime           @default(now())
  endDate                DateTime
  isTrial                Boolean            @default(false)
  razorpaySubscriptionId String             @unique
  startDate              DateTime           @default(now())
  status                 SubscriptionStatus @default(active)
  updatedAt              DateTime           @updatedAt
  customerEmail          String
  organizationId         String?
  organization           Organization?      @relation(fields: [organizationId], references: [id])
  user                   User?              @relation(fields: [userId], references: [id])

  @@index([razorpaySubscriptionId])
  @@index([status])
  @@index([organizationId])
}

enum AccessType {
  view
}

enum SubscriptionStatus {
  active
  trialing
  cancelled
  expired
}

enum Status {
  active
  inactive
}

enum MemberStatus {
  active
  inactive
  pending
  suspended
}

// ---------------------------------------------------------------------------
// Better Auth
//
// Session/Account/Verification are the core identity tables. Member and
// Invitation belong to the organization plugin and sit alongside the legacy
// Role + OrganizationMember tables during the migration; the legacy pair is
// removed once every read path has moved over.
//
// Permissions are deliberately NOT stored here. Member.role holds a role name
// that indexes into src/lib/org-roles.js, which is what keeps
// requireOrgPermission() and its call sites unchanged.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Set by the organization plugin so the active org travels with the session
  // instead of costing a lookup on every request.
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Hashed by Better Auth. Replaces the old plaintext User.password column.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model Member {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  // One of the names in src/lib/org-roles.js: owner | admin | manager | viewer
  role           String   @default("viewer")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  role           String   @default("viewer")
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}
